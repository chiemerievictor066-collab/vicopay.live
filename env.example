# ============================================================
# VicoPay Live - environment settings
# Copy this file to ".env" (same folder as server.js) and fill in real values.
# NEVER upload the real .env to GitHub or share it.
# ============================================================

# --- DATABASE (REQUIRED) ---------------------------------------------------------------
# PostgreSQL. All accounts, coins and transactions live here, so restarts and redeploys can never lose them.
#  * On Render: create a PostgreSQL database (PAID plan, see README section 4), then paste its
#    "Internal Database URL" here (in the Render dashboard Environment screen, not in this file).
#  * On your computer: install PostgreSQL and use e.g.
#      DATABASE_URL=postgres://postgres:password@localhost:5432/vicopay
DATABASE_URL=
# Optional tuning (the defaults are fine to start):
#   PGSSL=true|false        force SSL on/off (Render's external URL needs true; the internal URL needs nothing)
#   PG_POOL_MAX=10          most database connections this server copy may open
#   USER_CACHE_MAX=20000    accounts kept in memory (memory stays flat however many users you have)

# --- Server ---
PORT=3000
# The public address of your website (Paystack sends people back here, and Invite Friends links are built from it)
# Local testing:  http://localhost:3000     Live site:  https://vicopay.live
APP_URL=https://vicopay.live

# --- Security (REQUIRED for a live site) ---
# A long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# FIXED: this name must be written in CAPITAL letters. "AUTH_secret" is NOT read by the server, so everyone
# was being signed out every time the server restarted.
AUTH_SECRET=
# A secret you choose. Needed to open the /api/admin/* pages (send it as header x-admin-key)
ADMIN_KEY=

# --- LiveKit Cloud (LiveKit Cloud dashboard -> Settings -> Keys) ---
# ONE LiveKit account is enough. The SAME three values power normal Go Live AND Product Live (selling a registered product in a live). Do not create a second one.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Paystack (Paystack dashboard -> Settings -> API Keys & Webhooks) ---
# Use sk_test_... while testing and sk_live_... only when you are ready to take real money
PAYSTACK_SECRET_KEY=

# --- Resend: password reset, EMAIL VERIFICATION codes, payout approval emails, incoming mail ---
# Create a key at resend.com and verify your sending domain. Without these two lines
# the reset link / verification code is printed in the server console instead of being emailed.
# MAIL_FROM must use your VERIFIED domain, e.g.  VicoPay Live <hello@yourdomain.com>
RESEND_API_KEY=
MAIL_FROM=VicoPay Live <no-reply@vicopay.live>

# ONE Resend webhook does everything. In Resend: Webhooks -> Add Webhook
#   URL:    https://YOUR-SITE/api/resend/webhook
#   Events: email.received   (mail sent to your Resend receiving address is forwarded to INBOX_FORWARD_TO)
#           email.delivered, email.bounced, email.complained   (fake or unreachable emails can never qualify an Invite Friends referral)
# Resend then shows a signing secret that starts with whsec_ . Paste it here. Without it the webhook refuses every request.
RESEND_WEBHOOK_SECRET=
# Your real inbox. Every email sent to your Resend receiving address is forwarded here:
INBOX_FORWARD_TO=

# --- Payout protection (recommended) ---
# New gift stars are held this many days before a host can withdraw them (protects against card chargebacks)
PAYOUT_HOLD_DAYS=3
# Naira per $1. Used to turn the $9 creator payout into naira, so CHECK IT EVERY MONTH.
NGN_PER_USD=1500
# Shown to users on error pages and in the app footer (optional)
SUPPORT_EMAIL=
# Optional: shown on the Help Center. WhatsApp number with country code, digits only (e.g. 2348012345678)
SUPPORT_WHATSAPP=08126977572
# Optional: a sentence such as "We usually reply within 24 hours"
SUPPORT_REPLY_TIME=We usually reply within 24 hours

# ============================================================
# MONTHLY CREATOR PAYOUTS
# ============================================================
# The email that receives the approval code before any money is sent
PAYOUT_APPROVER_EMAIL=

# Extra secret that protects approval codes. Any long random text, different from the others.
# (If left empty it falls back to PAYSTACK_SECRET_KEY.)
PAYOUT_APPROVAL_SECRET=

# Approval email is sent with your existing RESEND_API_KEY above.
# MAIL_FROM above must use your VERIFIED Resend domain, or the code will not arrive.

# Safety limits (defaults shown)
PAYOUT_MAX_ITEM_USD=500
PAYOUT_MAX_BATCH_USD=10000
PAYOUT_RECIPIENT_COOLDOWN_HOURS=72
PAYOUT_APPROVAL_MINUTES=30

# Advanced (leave as is). Nigeria time = UTC+60 minutes
PAYOUT_SEND_DELAY_MS=400
PAYOUT_TZ_OFFSET_MIN=60

# Automatic mode: keep OFF until weeks of clean tests
PAYOUT_AUTO_CALCULATE=false
# 0 = every batch always needs your email code
PAYOUT_AUTO_APPROVE_MAX_USD=0

# ============================================================
# AD CENTER IDENTITY CHECKS + MARKETPLACE PAYMENTS
# ============================================================
# >>> PUT A SECRET KEY HERE. Advertisers' ID photos are encrypted with it before they are saved. Without it, ID uploads are refused.
# Make one with:   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# KEEP A BACKUP OF THIS KEY. If it is lost or changed, photos waiting for review cannot be opened (the person just uploads again).
ID_DOC_KEY=

# --- ID CHECK APPROVAL ---
# The email address that is told the moment an advertiser sends an ID for checking (works for both ID flows: Ad Center and the ad levels).
# The email never contains the ID photo or number: the approver opens the admin review page (admin-community.html / admin-ad-jobs.html) and approves or rejects there.
# Needs RESEND_API_KEY and MAIL_FROM above. Empty = it falls back to PAYOUT_APPROVER_EMAIL, then INBOX_FORWARD_TO. If none is set the ID simply waits in the review page.
ID_APPROVER_EMAIL=
# Optional: the page the email link opens (default: APP_URL + /admin-community.html)
# ID_REVIEW_URL=https://vicopay.live/admin-community.html
# true (default) = an advertiser must have an APPROVED ID before they can sell a product in a live (product-live.html). Set false only for testing.
ID_REQUIRED_FOR_PRODUCT_LIVE=true
# Ad payments and Marketplace purchases are charged in Naira through your existing PAYSTACK_SECRET_KEY.
# The Dollar button on the website only DISPLAYS prices in dollars, using NGN_PER_USD above (check it every month).
# Paystack webhook (already set up for coins): https://YOUR-SITE/api/paystack/webhook, it now also confirms ad and Marketplace payments.

# ============================================================
# VICO AI (the AI assistant in the Market Community and the Ad Center)
# ============================================================
# Get your key from https://console.groq.com/keys
# Keep this secret on the server. Do not put it in frontend HTML or JavaScript.
GROQ_API_KEY=
# Use Groq as the Vico AI provider.
AI_PROVIDER=groq
# Groq model ID. This is the default model used if left blank.
AI_MODEL=openai/gpt-oss-20b
# Groq's OpenAI-compatible API endpoint. Leave as shown unless Groq changes it.
AI_BASE_URL=https://api.groq.com/openai/v1
# Maximum messages ONE user may send to Vico AI per day.
AI_DAILY_LIMIT=30
# Longest answer Vico AI may write (tokens).
AI_MAX_TOKENS=700

# OPTIONAL (the server has built-in defaults; remove the # only to change them)
# ============================================================
# Email verification and Invite Friends need nothing more than the Resend lines above.
# Their rules (how many friends, how many coins, verification on/off) are set in admin-referrals.html, not here.
#
# PUBLIC_URL=https://vicopay.live        # only if invite links should use a different address than APP_URL
# BACKUP_DIR=./backups                   # where database backups are written
# FOREX_PRICE_USD=                       # Forex Academy price in dollars
# FOREX_PRICE_NGN=                       # Forex Academy price in naira
# FOREX_ACCESS_DAYS=                     # days of Forex Academy access after paying
# ENABLE_USD_PAYMENTS=                   # allow dollar card payments for coins
# COIN_MIN_USD=
# COIN_NGN_PER_USD=
# SMTP_HOST=                             # only if you ever want to send with your own mail server instead of Resend
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=

# --- LIVE PROMOTION (Processing Promotion -> Promotion Successful, and the Promotional Duration payment) ---
# Needs PAYSTACK_SECRET_KEY above. A streamer is promoted when they reach ALL the free goals below, OR buy the Promotional Duration.
# Promotion also gives them VIP (all the VIP features switch on). Price in dollars; if your Paystack account cannot take dollars the page offers Naira.
PROMO_PRICE_USD=12
PROMO_PRICE_NGN=19000
# How many days a bought promotion lasts. 0 = it never expires.
PROMO_DURATION_DAYS=30
PROMO_MIN_FOLLOWERS=1000
PROMO_MIN_LIKES=1000000
PROMO_MIN_STARS=12000
# "High Views": 0 = not counted. Set a number to also require that many lifetime viewers.
PROMO_MIN_VIEWS=0

# ---- Vico Message: phone verification by SMS (use Termii OR Twilio) ----
# Without one of these, people cannot verify their number on the live site.
TERMII_API_KEY=
TERMII_SENDER_ID=
# generic = normal SMS, dnd = reaches numbers on Nigeria's Do-Not-Disturb list (needs an approved sender ID), whatsapp = code sent on WhatsApp
TERMII_CHANNEL=generic
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1xxxxxxxxxx
# Set to off if calls to VIPs should be free through Vico Message (default: they follow the same paid-call rule as live calls)
# VM_VIP_CALL_GATE=off
