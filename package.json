{
  "name": "vicopay-live",
  "version": "1.0.0",
  "description": "VicoPay Live - live streaming with gifts, coins (Paystack), PostgreSQL ledger and creator payouts, powered by LiveKit",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js",
